# OracleDesk frontend configuration. Copy to .env.local and edit.
#
# Every NEXT_PUBLIC_* value is compiled into JavaScript that browsers
# download. Never put a private key, secret seed or API secret here.

# Backend API (OracleDesk-Backend). Local: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Stellar network. Defaults are Stellar Testnet.
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_STELLAR_EXPLORER_URL=

# Contract ids. Empty means "use lib/stellar/generated/deployments.testnet.json".
NEXT_PUBLIC_MARKET_CORE_CONTRACT_ID=
NEXT_PUBLIC_TREASURY_CONTRACT_ID=
NEXT_PUBLIC_RESOLVER_CONTRACT_ID=
NEXT_PUBLIC_REASONING_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_USDC_CONTRACT_ID=

# Where premium payments go. Must match the backend's PAYMENTS_RECIPIENT.
# Empty means the treasury contract (see docs/api.md).
NEXT_PUBLIC_PAYMENTS_RECIPIENT=
# Daily pass price shown and paid, in USDC. Must be >= the backend's
# DAILY_PASS_PRICE_RAW (default 0.5).
NEXT_PUBLIC_DAILY_PASS_PRICE_USDC=0.5

# Comma-separated G… addresses that see the admin pages. UI only: the
# backend enforces its own ADMIN_ADDRESSES.
NEXT_PUBLIC_ADMIN_ADDRESSES=

# Comma-separated agent G… addresses to pin on /admin/agents even if they have
# never emitted a registry event. Invalid entries are ignored with a warning.
NEXT_PUBLIC_KNOWN_AGENTS=

# YES-price tolerance (basis points) used by the /admin diagnostics sampler.
# Default 100 (1%). Increase for noisy testnet backends.
NEXT_PUBLIC_DIAGNOSTICS_TOLERANCE_BPS=100

# Mobile wallets over WalletConnect (LOBSTR, Freighter Mobile). Empty turns it off.
# Get a project id at https://cloud.reown.com (WalletConnect Cloud). Add this app's
# origin to the project's allowed origins, or pairing is refused.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# This app's public URL, shown to the wallet while it pairs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IPFS gateways for reading reasoning traces: a comma-separated pool, tried in
# order (https only, or http://localhost for local testing; at most 5 are used).
# Gateways see which CIDs a user verifies, so pick ones you trust.
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs,https://dweb.link/ipfs,https://gateway.pinata.cloud/ipfs
# Largest trace body read from a gateway, in bytes. Bigger responses are abandoned while streaming.
NEXT_PUBLIC_IPFS_MAX_TRACE_BYTES=1048576
# The contracts repo's x402 trace service (per-trace unlocks). Empty if not deployed.
NEXT_PUBLIC_X402_URL=

# Design gallery for the retired demo screens (/dev/gallery). Leave empty in
# production; the gallery 404s unless this is set to 1 or true at build time.
NEXT_PUBLIC_ENABLE_DEMO_ROUTES=

# Wallet interaction timeouts (milliseconds)
# Extension wallet timeout (Freighter, xBull): 2 minutes
NEXT_PUBLIC_WALLET_TIMEOUT_MS=120000
# Hardware/remote wallet timeout (Ledger, WalletConnect): 10 minutes
NEXT_PUBLIC_REMOTE_WALLET_TIMEOUT_MS=600000

# Event recovery configuration
# Maximum pages to fetch when recovering missed realtime events after disconnect
NEXT_PUBLIC_EVENTS_MAX_BACKFILL_PAGES=10

# Extra Soroban RPC endpoints for failover (comma-separated). The URL above stays primary.
# Endpoints whose network passphrase differs are never used. See docs/architecture.md.
NEXT_PUBLIC_STELLAR_RPC_URLS=

# Debug panels (config, wallet, cache, simulations, RPC pool). Always on in `next dev`.
# Set to 1 to include them in a production build; open with ?debug=1, ?debug=rpc or Ctrl/Cmd+Shift+D.
NEXT_PUBLIC_ENABLE_DEBUG_PANEL=
NEXT_PUBLIC_DEBUG_PANELS=
